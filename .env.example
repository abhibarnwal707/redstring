# Copy to .env (make quickstart does this for you and fills NEO4J_PASSWORD with a random value)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Optional: change if 7687 / 7474 are taken, or lower the memory on an 8 GB machine
# NEO4J_BOLT_PORT=7687
# NEO4J_HTTP_PORT=7474
# NEO4J_HEAP=2G
# NEO4J_PAGECACHE=2G

# The Ask tab needs a free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional second provider for experiments
OPENROUTER_API_KEY=

# Extractor: ollama (default, uses the model `make model-fetch` registers) | hf (PyTorch, no Ollama needed)
REDSTRING_EXTRACTOR=ollama
OLLAMA_HOST=http://localhost:11434
# Only for publishing models/datasets to the Hugging Face Hub (not needed to run the project)
HF_TOKEN=
